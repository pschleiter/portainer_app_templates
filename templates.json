{
  "version": "3",
  "templates": [
    {
      "id": 1,
      "type": 1,
      "title": "PostgreSQL",
      "description": "The most advanced open-source database",
      "categories": ["database"],
      "platform": "linux",
      "logo": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/postgres.png",
      "image": "postgres:latest",
      "restart_policy": "always",
      "env": [
        {
          "name": "POSTGRES_USER",
          "label": "Superuser"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "label": "Superuser password"
        }
      ],
      "volumes": [
        {
          "container": "/var/lib/postgresql/data",
          "bind": "postgres_data"
        }
      ],
      "labels": [
        {
          "name": "traefik.enable",
          "value": "false"
        }
      ]
    },
    {
      "id": 2,
      "type": 1,
      "title": "Gitea",
      "description": "Private, Fast, Reliable DevOps Platform",
      "categories": ["git"],
      "platform": "linux",
      "logo": "https://docs.gitea.com/img/favicon.png",
      "image": "docker.gitea.com/gitea:latest-rootless",
      "restart_policy": "always",
      "env": [
        {
          "name": "GITEA__database__DB_TYPE",
          "label": "Database type",
          "default": "postgres"
        },
        {
          "name": "GITEA__database__HOST",
          "label": "Database host",
          "default": "db:5432"
        },
        {
          "name": "GITEA__database__NAME",
          "label": "Database name"
        },
        {
          "name": "GITEA__database__USER",
          "label": "Database username"
        },
        {
          "name": "GITEA__database__PASSWD",
          "label": "Database password"
        }
      ],
      "volumes": [
        {
          "container": "/var/lib/gitea",
          "bind": "gitea_data"
        },
        {
          "container": "/etc/gitea",
          "bind": "gitea_config"
        }
      ],
      "labels": [
        {
          "name": "traefik.enable",
          "value": "false"
        },
        {
          "name": "traefik.http.routers.gitea.entrypoints",
          "value": "websecure"
        },
        {
          "name": "traefik.http.routers.gitea.tls",
          "value": "true"
        },
        {
          "name": "traefik.http.routers.gitea.rule",
          "value": "Host(`<hostname>`)"
        },
        {
          "name": "traefik.http.routers.gitea.service",
          "value": "gitea"
        },
        {
          "name": "traefik.http.services.gitea.loadbalancer.server.port",
          "value": "3000"
        }
      ]
    },
    {
      "id": 3,
      "type": 1,
      "title": "Nextcloud",
      "description": "Content collaboration platform.",
      "categories": ["fileshare"],
      "platform": "linux",
      "logo": "https://upload.wikimedia.org/wikipedia/commons/thumb/6/60/Nextcloud_Logo.svg/1920px-Nextcloud_Logo.svg.png",
      "image": "nextcloud:latest",
      "restart_policy": "on-failure",
      "env": [
        {
          "label": "Traefik IP",
          "name": "TRUSTED_PROXIES"
        },
        {
          "label": "Protocol",
          "name": "OVERWRITEPROTOCOL",
          "default": "https"
        }
      ],
      "volumes": [
        {
          "container": "/var/www/html",
          "bind": "nextcloud_data"
        }
      ],
      "labels": [
        {
          "name": "traefik.enable",
          "value": "false"
        },
        {
          "name": "traefik.http.routers.nextcloud.entrypoints",
          "value": "websecure"
        },
        {
          "name": "traefik.http.routers.nextcloud.tls",
          "value": "true"
        },
        {
          "name": "traefik.http.routers.nextcloud.rule",
          "value": "Host(`<hostname>`)"
        },
        {
          "name": "traefik.http.routers.nextcloud.service",
          "value": "nextcloud"
        },
        {
          "name": "traefik.http.services.nextcloud.loadbalancer.server.port",
          "value": "80"
        }
      ]
    }
  ]
}
